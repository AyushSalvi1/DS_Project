rules_version = '2';

// Starter Firestore security rules matching the data model this template
// uses out of the box. Paste this into Firebase Console > Firestore
// Database > Rules (or deploy via the Firebase CLI) after you connect your
// own project — see the root README's "Getting Started" section.
//
// Review and tighten these before shipping to real users; this is a
// reasonable starting point, not a guarantee of correctness for every
// custom field you add.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin access is granted by setting `role: "admin"` on a user's own
    // document in `users/{uid}` (see README — done manually from the
    // Firestore Console for the first admin account).
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }

      match /favorites/{productId} {
        allow read, write: if isOwner(uid);
      }

      // Written every time the owner opens a product detail screen — used
      // to power "Recommended for you" (see RecommendationEngine).
      match /recentlyViewed/{productId} {
        allow read, write: if isOwner(uid);
      }

      // Created by an admin's client when an order's status changes (see
      // OrderRepositoryImpl.updateOrderStatus) — the recipient only reads
      // and marks their own as read.
      match /notifications/{notificationId} {
        allow read, update: if isOwner(uid);
        allow create: if isAdmin();
        allow delete: if false;
      }

      // =========================================================================
      // AI Shopping Features — user-scoped subcollections under users/{uid}.
      // =========================================================================

      // عناصر قائمة الرغبات الذكية (مع السعر المستهدف والتنبيهات).
      match /wishlist/{productId} {
        allow read, write: if isOwner(uid);
      }

      // تنبيهات الأسعار والتوفر.
      match /priceAlerts/{alertId} {
        allow read, write: if isOwner(uid);
      }

      // تفضيلات التسوق الشخصية (مستند واحد تحت profile).
      match /profile/preferences {
        allow read, write: if isOwner(uid);
      }

      // إعدادات الخصوصية والتخصيص (مستند واحد تحت profile).
      match /profile/privacy {
        allow read, write: if isOwner(uid);
      }

      // ذاكرة التسوق (نشاط المستخدم).
      match /activity/{activityId} {
        allow read, write: if isOwner(uid);
      }

      // محادثة المساعد الذكي.
      match /assistantConversations/{messageId} {
        allow read, write: if isOwner(uid);
      }

      // مجموعات المنتجات (AI collection builder).
      match /collections/{collectionId} {
        allow read, write: if isOwner(uid);
      }

      // تقييمات المستخدم للتوصيات (تعلم الـ AI).
      match /recommendationFeedback/{feedbackId} {
        allow read, write: if isOwner(uid);
      }

      // انطباعات التوصيات (عدّاد يومي للتحليلات).
      match /recommendationImpressions/{impressionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // عروض التجار الخارجيين + تاريخ أسعارها (يسجلها سكرابر/Cloud Function).
    match /externalListings/{listingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /priceHistory/{pointId} {
        allow read: if isSignedIn();
        // العميل بيُسجّل نقطة سعر
        // اليوم لما بيضغط "تحقق
        // الآن" (في الإنتاج: سكرابر/
        // Cloud Function). create بس
        // عشان التاريخ ما يتعدّلش
        // أو يتمسح من غير admin.
        allow create: if isSignedIn() &&
            request.resource.data.keys().hasOnly(['date', 'price']) &&
            request.resource.data.price is num;
        allow update, delete: if isAdmin();
      }
    }

    // التجار الخارجيين ودرجات الموثوقية.
    match /merchants/{merchantId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Created by any signed-in customer's client when they place their own
    // order (see OrderRepositoryImpl.placeOrder) — only admins read them.
    match /admin_notifications/{notificationId} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Catalog data — public read (storefront browsing without sign-in),
    // writes restricted to the admin dashboard.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      // Submitting a review bumps `rating`/`reviewCount` (recomputed
      // client-side), and placing an order bumps `salesCount` — allow
      // those two narrow cases for any signed-in user, everything else
      // (price, stock, images, ...) stays admin-only.
      allow update: if isAdmin() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviewCount', 'salesCount']));
      allow create, delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /onboardingSlides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
